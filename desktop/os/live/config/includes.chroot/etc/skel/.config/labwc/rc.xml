<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>7</gap>
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="34" y="28" />
  </placement>

  <theme>
    <name>MurSchol</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>yes</dropShadowsOnTiled>
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>semibold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>medium</weight>
    </font>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
  </theme>

  <keyboard>
    <default />

    <!-- Atajos de recuperación declarados de forma explícita. Aunque el shell
         o el panel tengan un problema, el usuario conserva navegación básica. -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="murschol-files" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="murschol-browser" />
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="murschol-settings" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="sh /usr/local/bin/murschol-lock" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="/usr/local/bin/murschol-clipboard" />
    </keybind>
    <keybind key="W-S-u">
      <action name="Execute" command="/usr/local/bin/murschol-update" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="/usr/local/bin/murschol-session-menu" />
    </keybind>
    <keybind key="XF86Sleep">
      <action name="Execute" command="systemctl suspend" />
    </keybind>

    <!-- PipeWire/WirePlumber: no dependemos de pactl, que no forma parte de la
         instalación mínima. wpctl viene con WirePlumber y controla el grafo real. -->
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 10%-" />
    </keybind>

    <!-- Captura estilo Windows: región con Super+Shift+S y pantalla completa con Print. -->
    <keybind key="W-S-s">
      <action name="Execute" command="murschol-capture --region" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="murschol-capture --screen" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <!-- Las aplicaciones normales reciben minimizar, maximizar y cerrar.
       MurSchol Desktop es el fondo/shell y conserva únicamente su interfaz propia. -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" />
    <windowRule identifier="murschol-desktop" serverDecoration="no" />
    <windowRule identifier="murschol-panel" serverDecoration="no" />
  </windowRules>

  <!-- Alt+Tab conserva vistas previas, pero adopta los colores del tema MurSchol. -->
  <windowSwitcher preview="yes" outlines="yes" unshade="yes">
    <osd show="yes" style="classic" output="all" thumbnailLabelFormat="%T" />
    <fields>
      <field content="icon" width="8%" />
      <field content="desktop_entry_name" width="32%" />
      <field content="title" width="60%" />
    </fields>
  </windowSwitcher>
</labwc_config>
