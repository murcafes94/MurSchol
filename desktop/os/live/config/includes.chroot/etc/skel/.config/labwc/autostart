#!/bin/sh

# Propaga el entorno Wayland a servicios activados por systemd/dbus, incluidos
# los portales XDG usados por navegador, capturas, compartir pantalla y diálogos.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

# Fuerza el orden de controles también en aplicaciones GTK con decoración de cliente.
# Labwc ya usa icon:iconify,max,close para las decoraciones de servidor.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' 2>/dev/null || true
fi

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/murschol"
mkdir -p "$STATE_DIR"
DESKTOP_LOG="$STATE_DIR/desktop.log"
PANEL_LOG="$STATE_DIR/panel.log"
POLKIT_LOG="$STATE_DIR/polkit.log"
NOTIFY_LOG="$STATE_DIR/notifications.log"
IDLE_LOG="$STATE_DIR/idle.log"
PANEL_PID=""
PANEL_READY=0

# Evita que una sesión de uso prolongado acumule logs de diagnóstico sin límite.
trim_log() {
  log="$1"
  [ -f "$log" ] || return 0
  size="$(wc -c < "$log" 2>/dev/null || echo 0)"
  if [ "$size" -gt 1048576 ]; then
    tail -c 262144 "$log" > "$log.tmp" 2>/dev/null || true
    mv -f "$log.tmp" "$log" 2>/dev/null || true
  fi
}
for log in "$DESKTOP_LOG" "$PANEL_LOG" "$POLKIT_LOG" "$NOTIFY_LOG" "$IDLE_LOG"; do
  trim_log "$log"
done

# Las aplicaciones MurSchol y la ruta de recuperación usan notificaciones.
# Mako es nativo de Wayland/layer-shell y evita que notify-send quede sin receptor.
if command -v mako >/dev/null 2>&1; then
  if ! pgrep -u "$(id -u)" -x mako >/dev/null 2>&1; then
    mako >> "$NOTIFY_LOG" 2>&1 &
  fi
fi

# Un agente PolicyKit visible es imprescindible para operaciones administrativas
# disparadas desde aplicaciones gráficas. No iniciamos una segunda instancia.
if command -v lxqt-policykit-agent >/dev/null 2>&1; then
  if ! pgrep -u "$(id -u)" -x lxqt-policykit-agent >/dev/null 2>&1; then
    lxqt-policykit-agent >> "$POLKIT_LOG" 2>&1 &
  fi
fi

# Historial del portapapeles de la sesión. Se limpia al iniciar para no conservar
# contraseñas u otros datos sensibles entre reinicios. Super+V abre el selector.
if command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
  cliphist wipe >/dev/null 2>&1 || true
  wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
  wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
fi

# Mantiene el monitor de volúmenes de Thunar disponible para memorias USB y
# otros medios extraíbles aunque el usuario utilice MurSchol Files.
if command -v thunar >/dev/null 2>&1; then
  thunar --daemon >/dev/null 2>&1 &
fi

# En el sistema instalado, bloquear por inactividad y siempre antes de dormir.
# La sesión Live no tiene una contraseña PAM utilizable y se excluye a propósito.
if [ ! -e /run/live/medium ] && [ ! -e /run/live/overlay ] && command -v swayidle >/dev/null 2>&1; then
  if ! pgrep -u "$(id -u)" -x swayidle >/dev/null 2>&1; then
    swayidle -w \
      timeout 600 '/usr/local/bin/murschol-lock' \
      before-sleep '/usr/local/bin/murschol-lock' \
      >> "$IDLE_LOG" 2>&1 &
  fi
fi

# El perfil Ligero/Normal/Rendimiento debe afectar también al sistema real.
# systemd --user vigila settings.ini y ejecuta el helper solo cuando cambia.
if command -v powerprofilesctl >/dev/null 2>&1; then
  /usr/local/bin/murschol-power-profile >/dev/null 2>&1 || true
  if command -v systemctl >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    systemctl --user start murschol-power-profile.path >/dev/null 2>&1 || true
  fi
fi

# El dock global se prueba antes de arrancar el escritorio. Solo anunciamos
# MURSCHOL_EXTERNAL_PANEL si el proceso sobrevivió su inicialización; de lo
# contrario MurSchol Desktop conserva inmediatamente su dock integrado.
if [ -x /usr/local/bin/murschol-panel ]; then
  /usr/local/bin/murschol-panel >> "$PANEL_LOG" 2>&1 &
  PANEL_PID=$!
  sleep 1
  if kill -0 "$PANEL_PID" 2>/dev/null; then
    PANEL_READY=1
    export MURSCHOL_EXTERNAL_PANEL=1
  else
    unset MURSCHOL_EXTERNAL_PANEL 2>/dev/null || true
  fi
else
  unset MURSCHOL_EXTERNAL_PANEL 2>/dev/null || true
fi

/usr/local/bin/murschol-desktop >> "$DESKTOP_LOG" 2>&1 &
MURSCHOL_PID=$!

# Si una pieza crítica muere durante el arranque, mantener una ruta de rescate.
sleep 3
if ! kill -0 "$MURSCHOL_PID" 2>/dev/null; then
  foot -T "MurSchol OS - diagnóstico" sh -c 'LOG="${XDG_STATE_HOME:-$HOME/.local/state}/murschol/desktop.log"; echo "MurSchol Desktop no pudo iniciar."; echo; cat "$LOG" 2>/dev/null || true; echo; echo "Pulsa Enter para abrir una consola."; read _; exec sh' &
elif [ -x /usr/local/bin/murschol-panel ] && [ "$PANEL_READY" -eq 0 ]; then
  notify-send "MurSchol OS" "El panel externo no pudo iniciar. Se activó el dock integrado de respaldo." 2>/dev/null || true
fi

# Si el panel externo se cae más tarde, no dejamos al usuario sin navegación.
# Reiniciamos únicamente el shell de escritorio con su dock integrado; las
# ventanas de aplicaciones permanecen abiertas bajo labwc.
if [ "$PANEL_READY" -eq 1 ] && [ -n "$PANEL_PID" ]; then
  (
    while kill -0 "$PANEL_PID" 2>/dev/null; do
      sleep 3
    done

    if kill -0 "$MURSCHOL_PID" 2>/dev/null && pgrep -x labwc >/dev/null 2>&1; then
      notify-send "MurSchol OS" "El panel dejó de responder. Recuperando el dock integrado…" 2>/dev/null || true
      kill "$MURSCHOL_PID" 2>/dev/null || true
      sleep 1
      unset MURSCHOL_EXTERNAL_PANEL 2>/dev/null || true
      /usr/local/bin/murschol-desktop >> "$DESKTOP_LOG" 2>&1 &
    fi
  ) &
fi
