#!/bin/sh

# Propaga el entorno de la sesión a servicios iniciados por systemd/dbus.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

DESKTOP_LOG="$HOME/murschol-desktop.log"
PANEL_LOG="$HOME/murschol-panel.log"
PANEL_PID=""

# Solo desactivamos el dock integrado cuando el panel global realmente existe.
# Así una compilación sin LayerShellQt sigue siendo completamente utilizable.
if [ -x /usr/local/bin/murschol-panel ]; then
  export MURSCHOL_EXTERNAL_PANEL=1
else
  unset MURSCHOL_EXTERNAL_PANEL 2>/dev/null || true
fi

/usr/local/bin/murschol-desktop >> "$DESKTOP_LOG" 2>&1 &
MURSCHOL_PID=$!

if [ -x /usr/local/bin/murschol-panel ]; then
  /usr/local/bin/murschol-panel >> "$PANEL_LOG" 2>&1 &
  PANEL_PID=$!
fi

# Si una pieza crítica muere al iniciar, muestra automáticamente el error.
sleep 4
if ! kill -0 "$MURSCHOL_PID" 2>/dev/null; then
  foot -T "MurSchol OS - diagnóstico" sh -c 'echo "MurSchol Desktop no pudo iniciar."; echo; cat "$HOME/murschol-desktop.log" 2>/dev/null || true; echo; echo "Pulsa Enter para abrir una consola."; read _; exec sh' &
elif [ -n "$PANEL_PID" ] && ! kill -0 "$PANEL_PID" 2>/dev/null; then
  # El shell principal ya se inició con panel externo. Dejamos constancia clara
  # del fallo para esta alpha y mantenemos disponibles Alt+Tab y Super+D.
  foot -T "MurSchol Panel - diagnóstico" sh -c 'echo "El dock global de MurSchol no pudo iniciar."; echo; cat "$HOME/murschol-panel.log" 2>/dev/null || true; echo; echo "Puedes seguir usando Alt+Tab y Super+D. Reinicia la sesión para recuperar el dock integrado."; echo; echo "Pulsa Enter para abrir una consola."; read _; exec sh' &
fi
