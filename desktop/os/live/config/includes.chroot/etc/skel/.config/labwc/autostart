#!/bin/sh

# Propaga el entorno de la sesión a servicios iniciados por systemd/dbus.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

# El shell es el escritorio principal. Guardamos el log para que una alpha
# que falle no se quede en una pantalla negra imposible de diagnosticar.
LOG="$HOME/murschol-desktop.log"
/usr/local/bin/murschol-desktop >> "$LOG" 2>&1 &
MURSCHOL_PID=$!

# Si el shell muere al iniciar, muestra automáticamente el error en una terminal.
sleep 4
if ! kill -0 "$MURSCHOL_PID" 2>/dev/null; then
  foot -T "MurSchol OS - diagnóstico" sh -c 'echo "MurSchol Desktop no pudo iniciar."; echo; cat "$HOME/murschol-desktop.log" 2>/dev/null || true; echo; echo "Pulsa Enter para abrir una consola."; read _; exec sh' &
fi
