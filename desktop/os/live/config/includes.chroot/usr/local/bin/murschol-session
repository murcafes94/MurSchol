#!/bin/sh
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=MurSchol
export XDG_SESSION_DESKTOP=MurSchol
export XDG_SESSION_CLASS=user
export QT_QPA_PLATFORM=wayland
export QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough
export GDK_BACKEND=wayland,x11
export GTK_USE_PORTAL=1
export WLR_RENDERER_ALLOW_SOFTWARE=1

# Las aplicaciones normales deben conservar las decoraciones de labwc para
# minimizar, maximizar y cerrar. El shell y el panel declaran por sí mismos
# cuándo necesitan una superficie sin marco.
unset QT_WAYLAND_DISABLE_WINDOWDECORATION 2>/dev/null || true

# Navegadores Gecko y aplicaciones Chromium/Electron modernas priorizan Wayland,
# conservando XWayland como respaldo para software antiguo.
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# La interfaz base usa español de Ecuador. Inicializamos las carpetas XDG antes
# de arrancar Qt para que Files, Capture y las demás apps compartan las rutas.
mkdir -p "$HOME/.config"
if [ ! -f "$HOME/.config/user-dirs.dirs" ]; then
  cat > "$HOME/.config/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/Escritorio"
XDG_DOWNLOAD_DIR="$HOME/Descargas"
XDG_TEMPLATES_DIR="$HOME/Plantillas"
XDG_PUBLICSHARE_DIR="$HOME/Público"
XDG_DOCUMENTS_DIR="$HOME/Documentos"
XDG_MUSIC_DIR="$HOME/Música"
XDG_PICTURES_DIR="$HOME/Imágenes"
XDG_VIDEOS_DIR="$HOME/Vídeos"
EOF
fi

mkdir -p \
  "$HOME/Escritorio" \
  "$HOME/Descargas" \
  "$HOME/Plantillas" \
  "$HOME/Público" \
  "$HOME/Documentos" \
  "$HOME/Imágenes" \
  "$HOME/Música" \
  "$HOME/Vídeos"

# VirtualBox suele arrancar Wayland sin aceleración 3D en esta alpha.
# En ese caso forzamos renderizado por software para evitar pantalla negra.
PRODUCT_NAME="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
case "$PRODUCT_NAME" in
  *VirtualBox*)
    export WLR_RENDERER=pixman
    export LIBGL_ALWAYS_SOFTWARE=1
    export QT_QUICK_BACKEND=software
    ;;
esac

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/murschol"
mkdir -p "$STATE_DIR"
SESSION_LOG="$STATE_DIR/session.log"

# Debian con dbus-user-session mantiene un único bus compartido por el usuario.
# LightDM puede entregarnos ya ese bus; crear otro aislaría portales y servicios
# systemd --user. Solo creamos un bus privado cuando no existe uno disponible.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec labwc >> "$SESSION_LOG" 2>&1
fi

exec dbus-run-session -- labwc >> "$SESSION_LOG" 2>&1
