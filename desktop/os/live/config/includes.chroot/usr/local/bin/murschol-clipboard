#!/bin/sh
set -eu

if ! command -v cliphist >/dev/null 2>&1 || ! command -v wofi >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "MurSchol OS" "El historial del portapapeles no está disponible." 2>/dev/null || true
    fi
    exit 127
fi

selection="$(cliphist list 2>/dev/null | wofi --dmenu --prompt "Portapapeles" --insensitive --cache-file /dev/null 2>/dev/null || true)"
[ -n "$selection" ] || exit 0

printf '%s\n' "$selection" | cliphist decode | wl-copy
