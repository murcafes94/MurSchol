#!/bin/sh
set -eu

# El Reader acepta un archivo PDF en argv[1]. Su lanzador debe propagar el
# documento cuando se abre desde MurSchol Files o mediante la asociación MIME.
test -x /usr/local/bin/murschol-reader

cat > /usr/share/applications/murschol-reader.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Reader
GenericName=Lector de PDF
Comment=Lee documentos PDF en MurSchol OS
Exec=/usr/local/bin/murschol-reader %f
Icon=accessories-ebook-reader
Terminal=false
MimeType=application/pdf;
Categories=Office;Viewer;Education;
Keywords=pdf;documento;lector;reader;estudio;
StartupNotify=true
EOF

chmod 0644 /usr/share/applications/murschol-reader.desktop
update-desktop-database /usr/share/applications 2>/dev/null || true

grep -q '^Exec=/usr/local/bin/murschol-reader %f$' /usr/share/applications/murschol-reader.desktop
grep -q '^MimeType=application/pdf;$' /usr/share/applications/murschol-reader.desktop
