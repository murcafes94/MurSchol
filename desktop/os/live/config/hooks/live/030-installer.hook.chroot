#!/bin/sh
set -eu

# Calamares viene de Debian Trixie con una configuración probada para medios
# Live. MurSchol conserva ese backend y cambia únicamente su identidad visual.
if [ ! -x /usr/bin/calamares-install-debian ]; then
    echo "MurSchol installer: falta /usr/bin/calamares-install-debian" >&2
    exit 1
fi

if [ ! -f /etc/calamares/settings.conf ]; then
    echo "MurSchol installer: falta /etc/calamares/settings.conf" >&2
    exit 1
fi

if [ ! -f /etc/calamares/branding/murschol/branding.desc ]; then
    echo "MurSchol installer: falta el branding de MurSchol" >&2
    exit 1
fi

# Mantiene los módulos, particionado, EFI, cifrado y secuencia de instalación
# suministrados por Debian, pero selecciona la marca propia de MurSchol.
if grep -q '^[[:space:]]*branding:' /etc/calamares/settings.conf; then
    sed -i 's/^[[:space:]]*branding:.*/branding: murschol/' /etc/calamares/settings.conf
else
    printf '\nbranding: murschol\n' >> /etc/calamares/settings.conf
fi

# Evita que la configuración Debian intente crear un icono genérico en un
# escritorio tradicional. MurSchol publica el instalador mediante Inicio.
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop

# Oculta el lanzador Debian para no duplicar entradas en el índice de apps.
if [ -f /usr/share/applications/calamares-install-debian.desktop ]; then
    cat > /usr/share/applications/calamares-install-debian.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Debian Installer Backend
Exec=/usr/bin/calamares-install-debian
Icon=install-debian
Terminal=false
NoDisplay=true
Categories=System;
EOF
fi

cat > /usr/share/applications/murschol-installer.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Instalar MurSchol OS
GenericName=Instalador del sistema
Comment=Instala MurSchol OS de forma permanente en este equipo
Exec=/usr/bin/calamares-install-debian
Icon=/etc/calamares/branding/murschol/murschol-mark.svg
Terminal=false
Categories=System;Settings;
Keywords=MurSchol;instalar;install;sistema;disco;Calamares;
StartupNotify=true
EOF

chmod 0644 /usr/share/applications/murschol-installer.desktop

grep -q '^branding: murschol$' /etc/calamares/settings.conf

echo "MurSchol installer: Calamares registrado y branding MurSchol activado"
