#!/bin/sh
set -eu

build_murschol_app() {
  source_dir="$1"
  build_dir="$2"
  label="$3"

  echo "[MurSchol] Compilando ${label}..."
  cmake -S "$source_dir" \
        -B "$build_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local
  cmake --build "$build_dir" --parallel "$(nproc)"
  cmake --install "$build_dir"
}

build_murschol_app /usr/src/murschol-shell /tmp/murschol-build "shell"
build_murschol_app /usr/src/murschol-photos /tmp/murschol-photos-build "MurSchol Photos"
build_murschol_app /usr/src/murschol-capture /tmp/murschol-capture-build "MurSchol Capture"
build_murschol_app /usr/src/murschol-settings /tmp/murschol-settings-build "MurSchol Settings"
build_murschol_app /usr/src/murschol-media /tmp/murschol-media-build "MurSchol Media"
build_murschol_app /usr/src/murschol-music /tmp/murschol-music-build "MurSchol Music"
build_murschol_app /usr/src/murschol-calculator /tmp/murschol-calculator-build "MurSchol Calculator"
build_murschol_app /usr/src/murschol-calendar /tmp/murschol-calendar-build "MurSchol Calendar"
build_murschol_app /usr/src/murschol-reader /tmp/murschol-reader-build "MurSchol Reader"

# Durante la alpha, Settings y Photos se ejecutan mediante un wrapper mínimo
# que registra automáticamente un fallo de arranque y abre el diagnóstico si
# el proceso muere en los primeros segundos.
install -d /usr/local/lib/murschol
mv /usr/local/bin/murschol-settings /usr/local/lib/murschol/murschol-settings-bin
cat > /usr/local/bin/murschol-settings <<'EOF'
#!/bin/sh
exec /usr/local/bin/murschol-launch "MurSchol Settings" -- /usr/local/lib/murschol/murschol-settings-bin "$@"
EOF

mv /usr/local/bin/murschol-photos /usr/local/lib/murschol/murschol-photos-bin
cat > /usr/local/bin/murschol-photos <<'EOF'
#!/bin/sh
exec /usr/local/bin/murschol-launch "MurSchol Photos" -- /usr/local/lib/murschol/murschol-photos-bin "$@"
EOF

cat > /usr/share/applications/murschol-desktop.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Desktop
Comment=Escritorio principal de MurSchol OS
Exec=/usr/local/bin/murschol-desktop
Terminal=false
Categories=System;Education;
NoDisplay=true
EOF

cat > /usr/share/applications/murschol-files.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Files
GenericName=Gestor de archivos
Comment=Explora y organiza tus archivos en MurSchol OS
Exec=/usr/local/bin/murschol-files
Icon=system-file-manager
Terminal=false
MimeType=inode/directory;
Categories=System;FileTools;Utility;
Keywords=archivos;carpetas;documentos;files;folders;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-photos.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Photos
GenericName=Visor de imágenes
Comment=Abre y anota imágenes en MurSchol OS
Exec=/usr/local/bin/murschol-photos %f
Icon=image-viewer
Terminal=false
MimeType=image/jpeg;image/png;image/gif;image/svg+xml;image/webp;
Categories=Graphics;Viewer;
Keywords=fotos;imagenes;capturas;photos;images;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-capture.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Capture
GenericName=Capturas de pantalla
Comment=Captura una región o la pantalla completa
Exec=/usr/local/bin/murschol-capture
Icon=applets-screenshooter
Terminal=false
Categories=Graphics;Utility;
Keywords=captura;pantalla;screenshot;screen;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-settings.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Settings
GenericName=Configuración
Comment=Configura MurSchol OS
Exec=/usr/local/bin/murschol-settings
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=configuracion;ajustes;settings;sistema;apariencia;dock;rendimiento;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-media.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Media
GenericName=Reproductor multimedia
Comment=Reproduce audio y vídeo con el motor multimedia de MurSchol
Exec=/usr/local/bin/murschol-media %f
Icon=multimedia-player
Terminal=false
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/x-wav;audio/mp4;video/mp4;video/x-matroska;video/webm;video/quicktime;
Categories=AudioVideo;Player;
Keywords=audio;video;musica;media;reproductor;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-music.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Music
GenericName=Biblioteca musical
Comment=Organiza música local, listas, cola, favoritos y letras
Exec=/usr/local/bin/murschol-music
Icon=multimedia-audio-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=musica;canciones;audio;letras;listas;music;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-calculator.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Calculator
GenericName=Calculadora
Comment=Calculadora estándar, científica, conversor y programador
Exec=/usr/local/bin/murschol-calculator
Icon=accessories-calculator
Terminal=false
Categories=Utility;Calculator;Education;
Keywords=calculadora;matematicas;cientifica;conversion;calculator;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-calendar.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Calendar
GenericName=Calendario
Comment=Organiza clases, tareas, celebraciones y recordatorios
Exec=/usr/local/bin/murschol-calendar
Icon=x-office-calendar
Terminal=false
Categories=Office;Calendar;Education;
Keywords=calendario;agenda;eventos;recordatorios;calendar;
StartupNotify=true
EOF

cat > /usr/share/applications/murschol-reader.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=MurSchol Reader (Preview)
GenericName=Biblioteca y lector
Comment=Vista previa de la biblioteca y experiencia de lectura de MurSchol
Exec=/usr/local/bin/murschol-reader
Icon=accessories-ebook-reader
Terminal=false
Categories=Office;Viewer;Education;
Keywords=biblioteca;lector;libros;reader;estudio;
StartupNotify=true
EOF

for binary in \
  murschol-desktop \
  murschol-files \
  murschol-photos \
  murschol-capture \
  murschol-settings \
  murschol-media \
  murschol-music \
  murschol-calculator \
  murschol-calendar \
  murschol-reader \
  murschol-browser \
  murschol-launch; do
  if [ -e "/usr/local/bin/$binary" ]; then
    chmod 0755 "/usr/local/bin/$binary"
  fi
done

chmod 0755 /usr/local/lib/murschol/murschol-settings-bin
chmod 0755 /usr/local/lib/murschol/murschol-photos-bin

if [ -x /usr/local/bin/murschol-panel ]; then
  chmod 0755 /usr/local/bin/murschol-panel
  echo "[MurSchol] Panel global wlr-layer-shell instalado."
else
  echo "[MurSchol] Aviso: panel global no disponible; el shell conservará el dock integrado."
fi

# Actualiza asociaciones para que Inicio y la búsqueda detecten todas las apps.
update-desktop-database /usr/share/applications 2>/dev/null || true

rm -rf \
  /tmp/murschol-build \
  /tmp/murschol-photos-build \
  /tmp/murschol-capture-build \
  /tmp/murschol-settings-build \
  /tmp/murschol-media-build \
  /tmp/murschol-music-build \
  /tmp/murschol-calculator-build \
  /tmp/murschol-calendar-build \
  /tmp/murschol-reader-build \
  /usr/src/murschol-shell \
  /usr/src/murschol-photos \
  /usr/src/murschol-capture \
  /usr/src/murschol-settings \
  /usr/src/murschol-media \
  /usr/src/murschol-music \
  /usr/src/murschol-calculator \
  /usr/src/murschol-calendar \
  /usr/src/murschol-reader

echo "[MurSchol] Shell instalado en /usr/local/bin/murschol-desktop"
echo "[MurSchol] MurSchol Files instalado en /usr/local/bin/murschol-files"
echo "[MurSchol] MurSchol Photos instalado en /usr/local/bin/murschol-photos"
echo "[MurSchol] MurSchol Capture instalado en /usr/local/bin/murschol-capture"
echo "[MurSchol] MurSchol Settings instalado en /usr/local/bin/murschol-settings"
echo "[MurSchol] MurSchol Media instalado en /usr/local/bin/murschol-media"
echo "[MurSchol] MurSchol Music instalado en /usr/local/bin/murschol-music"
echo "[MurSchol] MurSchol Calculator instalado en /usr/local/bin/murschol-calculator"
echo "[MurSchol] MurSchol Calendar instalado en /usr/local/bin/murschol-calendar"
echo "[MurSchol] MurSchol Reader Preview instalado en /usr/local/bin/murschol-reader"
echo "[MurSchol] MurSchol Browser registrado en /usr/local/bin/murschol-browser"
echo "[MurSchol] Lanzador de diagnóstico instalado en /usr/local/bin/murschol-launch"
