<resources>
    <style name="Theme.MurSchol" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/murschol_bg</item>
        <item name="android:navigationBarColor">@color/murschol_bg</item>
        <item name="android:statusBarColor">@color/murschol_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/murschol_accent</item>
    </style>

    <style name="MurScholQuickTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">112dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">@color/murschol_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MurScholDockItem">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/murschol_text</item>
        <item name="android:textColor">@color/murschol_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
