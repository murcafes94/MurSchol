<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/murschol_bg"
    android:paddingLeft="24dp"
    android:paddingTop="18dp"
    android:paddingRight="24dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/murschol"
                android:textColor="@color/murschol_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textColor="@color/murschol_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/murschol_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/murschol_muted"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tu escritorio de estudio"
        android:textColor="@color/murschol_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/tileGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="22dp"
        android:columnCount="@integer/tile_columns"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <TextView
            android:id="@+id/tileMoodle"
            style="@style/MurScholTile"
            android:text="@string/aula_virtual" />

        <TextView
            android:id="@+id/tileLibrary"
            style="@style/MurScholTile"
            android:text="@string/biblioteca" />

        <TextView
            android:id="@+id/tileNotes"
            style="@style/MurScholTile"
            android:text="@string/apuntes" />

        <TextView
            android:id="@+id/tileInternet"
            style="@style/MurScholTile"
            android:text="@string/internet" />

        <TextView
            android:id="@+id/tileFiles"
            style="@style/MurScholTile"
            android:text="@string/archivos" />

        <TextView
            android:id="@+id/tileYoutube"
            style="@style/MurScholTile"
            android:text="@string/youtube" />
    </GridLayout>

    <TextView
        android:id="@+id/appsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_background"
        android:gravity="center"
        android:text="@string/apps"
        android:textColor="@color/murschol_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
