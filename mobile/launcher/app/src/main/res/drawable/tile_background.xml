<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/murschol_border" />
            <stroke android:width="1dp" android:color="@color/murschol_accent" />
            <padding android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/murschol_surface" />
            <stroke android:width="1dp" android:color="@color/murschol_border" />
            <padding android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp" />
        </shape>
    </item>
</selector>
